# Copy this file to .env and fill in your own values — never commit the real .env.

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=hospital_management
DB_USER=root
DB_PASSWORD=yourdbpassword
DB_HOST=localhost
DB_PORT=3306

# Django Settings
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True

# OpenWeatherMap API Key for Weather & AQI Predictions
# Location: Mumbai, Maharashtra
# Note: New API keys may take 10-20 minutes to activate
OPENWEATHER_API_KEY=your-openweather-api-key

# Razorpay (use TEST mode keys for development)
RAZORPAY_PUBLIC_KEY=rzp_test_YOUR_KEY_ID
RAZORPAY_SECRET_KEY=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=
